+
+  // 편집창에 새 글을 치고(Patch 안 함) 뒤로
+  await edit(page, (t) => t.replace('반가워', '버려질 글').replace('<h2>제목</h2>', '<h2>버려질 제목</h2>'));
+  await expect(page.getByTestId('test-area').locator('p.note')).toHaveText('버려질 글');

+import { test as base, expect } from '@playwright/test';
+import type { Page } from '@playwright/test';
+// [AI Note]: style 속성 글을 엔진과 같은 규칙으로 쪼개려고 DOM 없는 순수 함수만 상대 경로로 가져온다 (패키지 별칭은 Playwright가 모른다).

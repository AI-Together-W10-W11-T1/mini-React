+});
+
+describe('setAreaHtml — 위험한 것을 빼고 그린다 (§5 실행 가능한 HTML)', () => {
+  it('on… 속성 제거 (대소문자 섞어도)', () => {
+    const box = makeArea();
+    setAreaHtml(box, '<div ONCLICK="window.__pwned=1" onMouseOver="window.__pwned=2" id="a">글</div>');
+    const div = box.firstElementChild!;

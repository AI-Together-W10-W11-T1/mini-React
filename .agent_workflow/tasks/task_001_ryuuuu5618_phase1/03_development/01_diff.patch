+
+  it('javascript:가 아닌 주소는 그대로 둔다', () => {
+    const box = makeArea();
+    setAreaHtml(box, '<a href="/javascript:x">a</a><a href="#top">b</a><img src="data:image/png;base64,AAAA">');

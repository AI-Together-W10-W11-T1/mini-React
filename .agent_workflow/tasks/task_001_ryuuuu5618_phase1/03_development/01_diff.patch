+    const root = createVDomRoot(area);
+    const steps = ['<ul><li>1</li><li>2</li></ul>', '<ul><li>1</li><li>2</li><li>3</li></ul>', '<ul><li>2</li><li>3</li></ul><p>끝</p>'];
+    for (const html of steps) {

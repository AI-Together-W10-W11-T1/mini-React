+  // 글이 끝났는데 열려 있는 것들
+  while (stack.length > 1) {
+    issues.push(`<${stack[stack.length - 1].tag}> 태그가 닫히지 않았습니다.`);
+    closeTop();
+  }
+  return { tree: root.children, issues };

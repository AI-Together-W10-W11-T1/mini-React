+++ b/packages/react-dom-bindings/src/client/__tests__/vnodesToHtml.test.ts
@@ -0,0 +1,194 @@
+import { describe, it, expect } from 'vitest';
+import { COMMENT_NODE, TEXT_NODE } from '@mini-react/shared';
+import type { AreaChildren, VNode } from '@mini-react/shared';
+import { readAreaChildren } from '../domToVNode';
+import { vnodesToHtml } from '../vnodesToHtml';
+import { comment, el, text } from '../../../../shared/src/__tests__/helpers';
+
+function area(html: string): HTMLElement {
+  const box = document.createElement('div');
+  box.innerHTML = html;
+  return box;
+}
+
+// [테스트용 도우미] 나란히 붙은 글자 노드는 HTML 글로 쓰면 하나로 합쳐지므로(B19),
+// 왕복 비교 전에 인접한 글자 노드를 합치고 빈 글자("")는 버린다. DOM에서 읽은 VNode에는 이런 경우가 생기지 않는다.
+function mergeAdjacentText(nodes: readonly VNode[]): VNode[] {
+  const out: VNode[] = [];
+  for (const node of nodes) {
+    if (node.type === TEXT_NODE) {
+      const value = (node.props as { nodeValue: string }).nodeValue;
+      if (value === '') continue;
+      const last = out[out.length - 1];
+      if (last !== undefined && last.type === TEXT_NODE) {
+        out[out.length - 1] = text((last.props as { nodeValue: string }).nodeValue + value);
+        continue;
+      }
+      out.push(text(value));
+    } else if (typeof node.type === 'string' && node.type !== COMMENT_NODE) {
+      out.push({ ...node, children: mergeAdjacentText(node.children) });
+    } else {
+      out.push(node);
+    }
+  }
+  return out;
+}
+
+/** VNode → HTML 글 → 파싱 → domToVNode. 왕복 결과 */
+function roundTrip(children: AreaChildren): AreaChildren {
+  return readAreaChildren(area(vnodesToHtml(children)));
+}
+
+const SAMPLE = `<section id="card" class="card">
+  <h2>제목</h2>
+  <!-- 안내 문구 -->
+  <p class="note" style="color: red; font-size: 16px">안녕</p>
+  <ul>
+    <li>하나</li>
+    <li>둘</li>
+    <li>셋</li>
+  </ul>
+  <button disabled>잠김</button>
+</section>`;
+
+describe('vnodesToHtml', () => {
+  it('요소 · 글자를 HTML 글로 쓴다', () => {
+    expect(vnodesToHtml([el('p', {}, text('안녕'))])).toBe('<p>안녕</p>');
+  });
+
+  it('공백 텍스트 · 줄바꿈을 그대로 쓴다 (결정 5 B)', () => {
+    const children = [el('ul', {}, text('\n  '), el('li', {}, text('하나')), text('\n'))];
+    expect(vnodesToHtml(children)).toBe('<ul>\n  <li>하나</li>\n</ul>');
+  });
+
+  it('주석을 <!--…-->로 쓴다', () => {
+    expect(vnodesToHtml([comment(' 안내 '), el('p')])).toBe('<!-- 안내 --><p></p>');
+  });
+
+  it('값 있는 속성은 name="value"로 쓴다', () => {
+    expect(vnodesToHtml([el('a', { href: '/x', class: 'link' })])).toBe('<a href="/x" class="link"></a>');
+  });
+
+  it('속성 값의 & · "를 이스케이프한다', () => {
+    expect(vnodesToHtml([el('a', { title: 'a & "b"' })])).toBe('<a title="a &amp; &quot;b&quot;"></a>');
+  });
+
+  it('boolean 속성(값 "")은 name=""로 쓴다', () => {
+    expect(vnodesToHtml([el('button', { disabled: '' }, text('잠김'))])).toBe('<button disabled="">잠김</button>');
+  });
+
+  it('style StyleMap은 style 속성 글로 쓴다', () => {
+    const html = vnodesToHtml([el('p', { style: { color: 'red', 'font-size': '16px' } })]);
+    expect(html).toBe('<p style="color: red; font-size: 16px"></p>');
+  });
+
+  it('빈 style 묶음이면 style 속성을 쓰지 않는다 (B21)', () => {
+    expect(vnodesToHtml([el('p', { style: {} })])).toBe('<p></p>');
+  });
+
+  it('style 값 안의 따옴표도 속성 값으로 이스케이프되어 왕복한다', () => {
+    const children = [el('p', { style: { 'font-family': '"Noto Sans", serif' } })];
+    expect(roundTrip(children)).toEqual(children);
+  });
+
+  it('빈 태그(br hr img input …)는 닫는 태그를 쓰지 않는다', () => {
+    expect(vnodesToHtml([el('br'), el('hr'), el('img', { src: 'a.png' }), el('input', { type: 'text' })])).toBe(
+      '<br><hr><img src="a.png"><input type="text">',
+    );
+  });
+
+  it('텍스트의 < > &를 이스케이프한다 (특수문자)', () => {
+    const value = '<b>굵게 아님</b> & &amp; 😀';
+    expect(vnodesToHtml([el('p', {}, text(value))])).toBe('<p>&lt;b&gt;굵게 아님&lt;/b&gt; &amp; &amp;amp; 😀</p>');
+    expect(roundTrip([el('p', {}, text(value))])).toEqual([el('p', {}, text(value))]);
+  });
+
+  it('pre · textarea는 첫 줄바꿈이 파서에 먹히지 않게 보존한다', () => {
+    const children = [el('pre', {}, text('\n첫 줄')), el('textarea', {}, text('\n둘째'))];
+    expect(roundTrip(children)).toEqual(children);
+  });
+
+  it('pre의 첫 글자가 줄바꿈이 아니면 그대로 쓴다', () => {
+    expect(vnodesToHtml([el('pre', {}, text('줄\n바꿈'))])).toBe('<pre>줄\n바꿈</pre>');
+  });
+
+  it('최상위 0개 → 빈 글, 여러 개 → 이어 붙임', () => {
+    expect(vnodesToHtml([])).toBe('');
+    expect(vnodesToHtml([text('앞'), el('b', {}, text('가운데')), comment('c'), text('뒤')])).toBe('앞<b>가운데</b><!--c-->뒤');
+  });
+
+  it('props 값 정규화: 숫자 → 문자열, true → "", false · null · undefined · 함수는 쓰지 않는다', () => {
+    const html = vnodesToHtml([el('div', { tabindex: 3, hidden: true, a: false, b: null, c: undefined, d: () => 1 })]);
+    expect(html).toBe('<div tabindex="3" hidden=""></div>');
+  });
+
+  it('key는 HTML 글에 쓰지 않는다', () => {
+    expect(vnodesToHtml([{ ...el('li', {}, text('a')), key: 1 }])).toBe('<li>a</li>');
+  });
+
+  it('컴포넌트 VNode는 쓸 수 없다', () => {
+    expect(() => vnodesToHtml([{ type: () => el('div'), props: {}, children: [] }])).toThrow();
+  });
+
+  describe('왕복 (HTML 글 → 파싱 → domToVNode)', () => {
+    it('샘플을 읽은 VNode를 글로 쓰고 다시 읽으면 같다', () => {
+      const vnodes = readAreaChildren(area(SAMPLE));
+      expect(roundTrip(vnodes)).toEqual(vnodes);
+    });
+
+    it('샘플은 글로도 원문과 같다 (style 항목 사이 구분자 형식까지)', () => {
+      expect(vnodesToHtml(readAreaChildren(area(SAMPLE)))).toBe(SAMPLE.replace('<button disabled>', '<button disabled="">'));
+    });
+
+    it('중첩 · 주석 · 최상위 여러 개 · 특수문자가 섞인 입력', () => {
+      const html =
+        '앞<!-- c1 --><div id="a" data-x="1 &amp; 2"><span>&lt;tag&gt;</span><br><img src="x.png" alt=\'q"q\'></div>\n<p>😀 &amp;amp; </p>끝';
+      const vnodes = readAreaChildren(area(html));
+      expect(roundTrip(vnodes)).toEqual(vnodes);
+    });
+
+    it('표 · 목록 · 폼 요소', () => {
+      const html =
+        '<table><tbody><tr><td>1</td><td>2</td></tr></tbody></table><form><input type="checkbox" checked><select><option selected>a</option></select></form>';
+      const vnodes = readAreaChildren(area(html));
+      expect(roundTrip(vnodes)).toEqual(vnodes);
+    });
+  });
+
+  describe('원문 글 요소 (B18, 변환기 견고성 — 페이지에서는 <style>이 막힘)', () => {
+    it('<style> 안의 a > b · &는 이스케이프하지 않고 그대로 쓴다', () => {
+      const children = [el('style', {}, text('a > b { content: "&"; }'))];
+      expect(vnodesToHtml(children)).toBe('<style>a > b { content: "&"; }</style>');
+      expect(roundTrip(children)).toEqual(children);
+    });
+
+    it('<script> 안도 이스케이프하지 않는다', () => {
+      const children = [el('script', {}, text('if (a < b && c > d) {}'))];
+      expect(vnodesToHtml(children)).toBe('<script>if (a < b && c > d) {}</script>');
+      expect(roundTrip(children)).toEqual(children);
+    });
+
+    it('<textarea> 안은 이스케이프한다 (&gt; → 글자 > 로 읽힘) — 원문 글 요소와 대비', () => {
+      const children = [el('textarea', {}, text('a > b & c'))];
+      expect(vnodesToHtml(children)).toBe('<textarea>a &gt; b &amp; c</textarea>');
+      expect(roundTrip(children)).toEqual(children);
+    });
+  });
+
+  describe('인접한 글자 노드 (B19)', () => {
+    it('글자 노드 "a" · "b"는 글 ab로 합쳐진다', () => {
+      expect(vnodesToHtml([el('p', {}, text('a'), text('b'))])).toBe('<p>ab</p>');
+    });
+
+    it('왕복 비교는 인접 글자 노드를 합친 뒤 한다 (mergeAdjacentText)', () => {
+      const children = [el('p', {}, text('a'), text('b'), el('b', {}, text('c'), text(''), text('d')), text('e'), text('f'))];
+      expect(roundTrip(children)).toEqual(mergeAdjacentText(children));
+      expect(mergeAdjacentText(children)).toEqual([el('p', {}, text('ab'), el('b', {}, text('cd')), text('ef'))]);
+    });
+
+    it('DOM에서 읽은 VNode에는 인접 글자 노드가 생기지 않는다', () => {
+      const vnodes = readAreaChildren(area('a<b>c</b>d &amp; e'));
+      expect(mergeAdjacentText(vnodes)).toEqual(vnodes);
+    });
+  });
+});
diff --git a/packages/react-dom-bindings/src/client/checkHtml.ts b/packages/react-dom-bindings/src/client/checkHtml.ts
new file mode 100644
index 0000000..670343b
--- /dev/null
+++ b/packages/react-dom-bindings/src/client/checkHtml.ts
@@ -0,0 +1,163 @@
+import { scanDangerous } from './sanitize';
+import type { DangerousFinding } from './sanitize';
+import { scanHtml } from './htmlScan';
+import type { ScanNode } from './htmlScan';
+
+/**
+ * Patch 때 알려 줄 문제 종류 (알림 말머리 5종과 1:1).
+ * - `PATCH_ERROR`는 `checkHtml`이 아니라 Patch 도중 예외(C2)를 페이지가 알릴 때 쓴다 (Dev-17)
+ */
+export type HtmlProblemKind = 'DANGEROUS' | 'UNPAIRED' | 'STRUCTURE' | 'SVG' | 'PATCH_ERROR';
+
+export interface HtmlProblem {
+  readonly kind: HtmlProblemKind;
+  /** 말머리를 뺀 한 줄 설명 */
+  readonly message: string;
+}
+
+/** 알림 말머리 (dev_todo 「Patch 때 검사 알림 문구」 — e2e가 이 말마디로 확인한다) */
+export const PROBLEM_LABELS: Readonly<Record<HtmlProblemKind, string>> = {
+  DANGEROUS: '[위험한 코드]',
+  UNPAIRED: '[태그 짝]',
+  STRUCTURE: '[구조 불일치]',
+  SVG: '[SVG 미지원]',
+  PATCH_ERROR: '[Patch 오류]',
+};
+
+const RETRY_LINE = '다시 작성해 주세요.';
+
+// [AI Note]: Patch 버튼을 눌렀을 때 편집창 글을 검사한다. 문제가 하나라도 있으면 페이지가 alert로 알리고 Patch를 막는다.
+// 위험 코드의 기준은 sanitize.ts의 scanDangerous 하나뿐이다 (미리보기에서 빼는 것과 같은 목록).
+// 글을 살아 있는 문서에 넣지 않고 <template> 안에서 읽는다. 검사 순서(알림 줄 순서) = 위험한 코드 → SVG → 태그 짝 → 구조.
+// 태그 짝 · 구조는 htmlScan(엔진이 글을 직접 훑은 결과)과 브라우저가 읽은 나무를 비교해 찾는다.
+// 브라우저는 빠진 닫는 태그 · 잘못 놓인 태그를 몰래 고쳐 읽으므로, 고치기 전의 "쓴 모습"과 비교해야 알아챌 수 있다.
+export function checkHtml(html: string): HtmlProblem[] {
+  const template = document.createElement('template');
+  template.innerHTML = html;
+  const fragment = template.content;
+
+  const problems: HtmlProblem[] = [];
+  for (const finding of scanDangerous(fragment)) {
+    problems.push({ kind: 'DANGEROUS', message: describeDangerous(finding) });
+  }
+  // 몇 개가 있든(중첩 포함) 한 줄로 알린다. 파서가 `<SVG>`도 소문자 svg로 읽어 주므로 대소문자는 신경 쓰지 않는다
+  if (fragment.querySelector('svg') !== null) {
+    problems.push({ kind: 'SVG', message: '<svg> 요소는 지원하지 않습니다.' });
+  }
+
+  const scan = scanHtml(html);
+  for (const message of scan.issues.slice(0, MAX_PAIR_LINES)) {
+    problems.push({ kind: 'UNPAIRED', message });
+  }
+  if (scan.issues.length > MAX_PAIR_LINES) {
+    problems.push({ kind: 'UNPAIRED', message: `그 밖에 ${scan.issues.length - MAX_PAIR_LINES}건의 짝 문제가 더 있습니다.` });
+  }
+
+  const mismatch = findStructureMismatch(scan.tree, readBrowserTree(fragment), null);
+  if (mismatch !== null) {
+    const parent = mismatch.parent === null ? '최상위에서' : `<${mismatch.parent}> 안에서`;
+    problems.push({
+      kind: 'STRUCTURE',
+      message: `${parent} 입력한 구조(${outline(mismatch.written)})와 브라우저가 읽은 구조(${outline(mismatch.parsed)})가 다릅니다.`,
+    });
+  }
+  return problems;
+}
+
+// 짝 문제 줄이 너무 많으면 알림이 화면을 넘치므로 앞의 몇 줄만 적는다
+const MAX_PAIR_LINES = 5;
+
+/** 알림 글: 문제 한 줄 = `[말머리] 설명`, 마지막 줄 "다시 작성해 주세요." (Patch 오류만 있으면 자체 안내가 있어 붙이지 않음) */
+export function formatProblems(problems: readonly HtmlProblem[]): string {
+  const lines = problems.map((p) => `${PROBLEM_LABELS[p.kind]} ${p.message}`);
+  if (problems.some((p) => p.kind !== 'PATCH_ERROR')) lines.push(RETRY_LINE);
+  return lines.join('\n');
+}
+
+function describeDangerous(finding: DangerousFinding): string {
+  switch (finding.kind) {
+    case 'ELEMENT':
+      // <link>는 rel="stylesheet"일 때만 막히므로 그 모습 그대로 적는다
+      return finding.element === 'link' ? '<link rel="stylesheet"> 요소' : `<${finding.element}> 요소`;
+    case 'EVENT_ATTRIBUTE':
+      return `<${finding.element}> 요소의 ${finding.attribute} 속성`;
+    case 'JAVASCRIPT_URL':
+      return `<${finding.element}> 요소의 ${finding.attribute} 속성 (javascript: 주소)`;
+  }
+}
+
+// 브라우저가 읽은 요소 나무 (글자 · 주석은 뺀다). <template>은 안쪽(content)을 자식으로 본다. 반복문으로 훑어 깊은 트리에서도 안전하다
+function readBrowserTree(fragment: DocumentFragment): ScanNode[] {
+  const root: ScanNode = { tag: '#root', children: [] };
+  const work: Array<{ source: ParentNode; into: ScanNode }> = [{ source: fragment, into: root }];
+  while (work.length > 0) {
+    const { source, into } = work.pop()!;
+    for (const child of Array.from(source.children)) {
+      const node: ScanNode = { tag: child.localName.toLowerCase(), children: [] };
+      into.children.push(node);
+      work.push({ source: child instanceof HTMLTemplateElement ? child.content : child, into: node });
+    }
+  }
+  return root.children;
+}
+
+interface Mismatch {
+  readonly parent: string | null;
+  readonly written: readonly ScanNode[];
+  readonly parsed: readonly ScanNode[];
+}
+
+// 두 나무를 위에서부터 비교해 처음 다른 형제 목록을 돌려준다 (같으면 null). 태그 이름 · 중첩만 비교한다
+function findStructureMismatch(written: readonly ScanNode[], parsed: readonly ScanNode[], parent: string | null): Mismatch | null {
+  const pending: Array<{ written: readonly ScanNode[]; parsed: readonly ScanNode[]; parent: string | null }> = [
+    { written, parsed, parent },
+  ];
+  // 문서 순서대로 "처음 다른 곳"을 찾으려고 스택에 뒤에서부터 넣는다
+  while (pending.length > 0) {
+    const level = pending.pop()!;
+    // [AI Note]: C1 예외 — 브라우저가 <table> 안에 몰래 끼운 <tbody>만 같은 것으로 본다(그 자식을 <table> 자식으로 펼쳐 비교).
+    // 입력에도 그 자리에 <tbody>가 있었다면 직접 쓴 것이라 펼치지 않는다. <tr>까지 자동으로 추가되는 `<table><td>`는 그대로 불일치.
+    const parsedChildren = level.parent === 'table' ? flattenAutoTbody(level.written, level.parsed) : level.parsed;
+    if (level.written.length !== parsedChildren.length || level.written.some((w, k) => w.tag !== parsedChildren[k].tag)) {
+      return { parent: level.parent, written: level.written, parsed: parsedChildren };
+    }
+    for (let k = level.written.length - 1; k >= 0; k--) {
+      pending.push({ written: level.written[k].children, parsed: parsedChildren[k].children, parent: level.written[k].tag });
+    }
+  }
+  return null;
+}
+
+function flattenAutoTbody(written: readonly ScanNode[], parsed: readonly ScanNode[]): ScanNode[] {
+  const out: ScanNode[] = [];
+  for (const node of parsed) {
+    if (node.tag === 'tbody' && written[out.length]?.tag !== 'tbody') out.push(...node.children);
+    else out.push(node);
+  }
+  return out;
+}
+
+// 알림 글에 넣을 짧은 구조 요약: `<p><div></div></p>`, 길면 자른다
+function outline(nodes: readonly ScanNode[]): string {
+  const parts: string[] = [];
+  const work: Array<ScanNode | string> = [];
+  for (let k = nodes.length - 1; k >= 0; k--) work.push(nodes[k]);
+  let length = 0;
+  while (work.length > 0 && length < OUTLINE_LIMIT) {
+    const item = work.pop()!;
+    if (typeof item === 'string') {
+      parts.push(item);
+      length += item.length;
+      continue;
+    }
+    const open = `<${item.tag}>`;
+    parts.push(open);
+    length += open.length;
+    work.push(`</${item.tag}>`);
+    for (let k = item.children.length - 1; k >= 0; k--) work.push(item.children[k]);
+  }
+  const text = parts.join('');
+  return work.length > 0 ? `${text.slice(0, OUTLINE_LIMIT)}…` : text;
+}
+
+const OUTLINE_LIMIT = 60;
diff --git a/packages/react-dom-bindings/src/client/domToVNode.ts b/packages/react-dom-bindings/src/client/domToVNode.ts
new file mode 100644
index 0000000..732091c
--- /dev/null
+++ b/packages/react-dom-bindings/src/client/domToVNode.ts
@@ -0,0 +1,43 @@
+import { COMMENT_NODE, TEXT_NODE } from '@mini-react/shared';
+import type { AreaChildren, ElementVNode, Props, StyleMap, VNode } from '@mini-react/shared';
+import { parseStyleText } from './style';
+
+// [AI Note]: 실제 DOM → VNode. 공백 텍스트 · 주석도 모두 남겨 VNode 자식 번호 = DOM childNodes 번호가 되게 한다 (알고리즘 결정 5 B).
+// 값 없는 속성(boolean)은 DOM이 이미 값 ""로 주므로 그대로 담는다. style은 글을 직접 쪼갠 StyleMap으로 담는다.
+export function domToVNode(node: Node): VNode {
+  switch (node.nodeType) {
+    case Node.TEXT_NODE:
+      return { type: TEXT_NODE, props: { nodeValue: node.nodeValue ?? '' }, children: [] };
+    case Node.COMMENT_NODE:
+      return { type: COMMENT_NODE, props: { nodeValue: node.nodeValue ?? '' }, children: [] };
+    case Node.ELEMENT_NODE: {
+      const element = node as Element;
+      return {
+        type: element.localName,
+        props: readProps(element),
+        children: Array.from(element.childNodes, domToVNode),
+      } satisfies ElementVNode;
+    }
+    default:
+      throw new Error(`domToVNode는 이 종류의 노드(nodeType ${node.nodeType})를 지원하지 않습니다.`);
+  }
+}
+
+// 영역 상자 자신은 읽지 않고 안의 자식 목록만 읽는다 (§5 영역 상자 = 보이지 않는 감싸개)
+export function readAreaChildren(area: Element): AreaChildren {
+  return Array.from(area.childNodes, domToVNode);
+}
+
+function readProps(element: Element): Props {
+  const props: { [name: string]: string | StyleMap } = {};
+  for (const attr of Array.from(element.attributes)) {
+    if (attr.name === 'style') {
+      // 항목이 하나도 없으면 style props를 두지 않는다 (B21)
+      const map = parseStyleText(attr.value);
+      if (Object.keys(map).length > 0) props.style = map;
+    } else {
+      props[attr.name] = attr.value;
+    }
+  }
+  return props;
+}
diff --git a/packages/react-dom-bindings/src/client/htmlScan.ts b/packages/react-dom-bindings/src/client/htmlScan.ts

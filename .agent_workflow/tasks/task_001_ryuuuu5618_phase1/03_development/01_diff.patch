+}
+
+/** 편집창 글을 일부 바꿔 Patch하고, 그 상태(S)를 돌려준다. 편집창 글은 Patch 직후 친 그대로다 */
+async function patchWith(page: Page, fn: (current: string) => string): Promise<State> {
+  await edit(page, fn);

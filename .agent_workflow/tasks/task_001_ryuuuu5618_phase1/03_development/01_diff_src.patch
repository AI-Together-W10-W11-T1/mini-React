diff --git a/packages/react-dom/src/createVDomRoot.ts b/packages/react-dom/src/createVDomRoot.ts
new file mode 100644
index 0000000..6337e66
--- /dev/null
+++ b/packages/react-dom/src/createVDomRoot.ts
@@ -0,0 +1,82 @@
+import { diff, invertPatches } from '@mini-react/react-reconciler';
+import { patch, readAreaChildren, renderAreaChildren } from '@mini-react/react-dom-bindings';
+import type { PatchObserver } from '@mini-react/react-dom-bindings';
+import type { AreaChildren, Patch } from '@mini-react/shared';
+import { History } from './history';
+
+export interface CreateVDomRootOptions {
+  /**
+   * Diff 시각화(확장)용 관찰 콜백. `update` · `back` · `forward`가 실제 영역에 patch를 하나 적용할 때마다
+   * `{ patch, node, stage }`로 불린다 (REMOVE는 지우기 직전 `before`, 나머지는 적용 직후 `after`).
+   * 무변경 `update` · 경계 이동처럼 patch가 없으면 불리지 않고, 예외 복구(C2)의 다시 그리기도 알리지 않는다.
+   */
+  onPatch?: PatchObserver;
+}
+
+export interface VDomRoot {
+  /** 지금(current) 기록의 VNode. 테스트 영역 · 편집창 · 다음 Patch의 기준 */
+  snapshot(): AreaChildren;
+  /**
+   * Patch 흐름: 지금 기록의 VNode와 next를 diff → 실제 영역에 patch → 새 기록으로 저장.
+   * 바뀐 게 없으면 아무것도 하지 않고 `false` (무변경 Patch는 기록하지 않는다, §3.3).
+   * patch 도중 예외가 나면 기록은 그대로 두고 실제 영역을 지금 기록으로 복구한 뒤 원래 예외를 다시 던진다 (C2).
+   */
+  update(next: AreaChildren): boolean;
+  /**
+   * 한 칸 뒤로: 실제 영역에 저장해 둔 역패치(이미 역순)를 적용하고 이동한 기록의 snapshot을 돌려준다.
+   * 처음(0번)이면 아무 일 없이 `null` (경계 무시). 호출한 쪽이 돌려받은 snapshot으로 테스트 영역 · 편집창을 채운다.
+   * 이동 도중 예외가 나면 C2와 같은 복구 후 원래 예외를 다시 던지고 current는 움직이지 않는다.
+   */
+  back(): AreaChildren | null;
+  /** 한 칸 앞으로: 저장해 둔 patches를 순서대로 적용. 끝이면 `null`. 나머지는 `back`과 같다 */
+  forward(): AreaChildren | null;
+}
+
+// [AI Note]: react-dom은 DOM을 직접 만지지 않는다. DOM 접근은 전부 react-dom-bindings(readAreaChildren · patch · renderAreaChildren)를 거친다.
+// 만들 때 실제 영역을 딱 한 번 읽어 0번 기록으로 삼고(P1-20), 그 뒤 diff 기준은 항상 History에 저장한 VNode다.
+// 실제 영역 DOM을 다시 읽어 비교하면 P1-33("두 VNode를 비교")을 어기고, 바깥에서 고친 DOM에 기준이 흔들린다.
+export function createVDomRoot(realArea: Element, options: CreateVDomRootOptions = {}): VDomRoot {
+  const { onPatch } = options;
+  const history = new History({ snapshot: readAreaChildren(realArea), patches: [], inverse: [] });
+
+  // [AI Note]: C2 복구 경로 한 개. 영역을 통째로 다시 그리는 것은 정상 갱신에서는 금지(P1-24 · P1-34)이고,
+  // patch 도중 예외로 DOM이 반쯤 적용된 상태가 되었을 때 "지금 기록 모습"으로 되돌리는 이 한 곳에서만 쓴다.
+  // 복구 뒤 원래 예외를 그대로 다시 던져 페이지(fixture)가 알릴 수 있게 한다.
+  // update · back · forward가 모두 이 함수를 지나므로, 기록(current)은 patch가 성공한 뒤에만 움직이고 실패하면 건드리지 않는다.
+  function applyOrRecover(patches: readonly Patch[]): void {
+    try {
+      // [AI Note]: 세 동작(update · back · forward)이 모두 이 함수를 지나므로 관찰 콜백도 여기 한 곳에서 전달한다 (Diff 시각화).
+      patch(realArea, patches, onPatch);
+    } catch (error) {
+      renderAreaChildren(realArea, history.current.entry.snapshot);
+      throw error;
+    }
+  }
+
+  return {
+    snapshot: () => history.current.entry.snapshot,
+
+    update(next) {
+      const patches = diff(history.current.entry.snapshot, next);
+      if (patches.length === 0) return false;
+      applyOrRecover(patches);
+      history.push({ snapshot: next, patches, inverse: invertPatches(patches) });
+      return true;
+    },
+
+    back() {
+      const here = history.current;
+      if (here.prev === null) return null;
+      // inverse는 이미 역순으로 뒤집어 둔 목록이라 그대로 순서대로 적용한다 (결정 7 · 되돌리는 순서 = 역순)
+      applyOrRecover(here.entry.inverse);
+      return history.back()!.snapshot;
+    },
+
+    forward() {
+      const target = history.current.next;
+      if (target === null) return null;
+      applyOrRecover(target.entry.patches);
+      return history.forward()!.snapshot;
+    },
+  };
+}
diff --git a/packages/react-dom/src/history.ts b/packages/react-dom/src/history.ts
new file mode 100644
index 0000000..f624b83
--- /dev/null
+++ b/packages/react-dom/src/history.ts
@@ -0,0 +1,77 @@
+import { HISTORY_LIMIT } from '@mini-react/shared';
+import type { HistoryEntry, HistoryNode } from '@mini-react/shared';
+
+// [AI Note]: State History = 양방향 연결 리스트 (알고리즘 결정 7 B + VNode). head(가장 오래된) · current(지금) · size(개수).
+// 순수 데이터라 DOM을 모른다. 실제 DOM에 적용하는 일(역패치 · patch)은 createVDomRoot가 한다.
+// 연결 리스트를 고른 이유: 한도 50을 넘으면 맨 앞(head)을 빼야 하는데, 배열이면 번호를 전부 당겨야 한다.
+// 저장한 HistoryEntry는 절대 고치지 않는다 (P1-27). 노드의 prev · next만 바뀐다.
+export class History {
+  #head: HistoryNode;
+  #current: HistoryNode;
+  #size = 1;
+
+  /** 초기 모습이 0번 기록 = 뒤로가기의 바닥 (§3.3) */
+  constructor(initial: HistoryEntry) {
+    this.#head = this.#current = { entry: initial, prev: null, next: null };
+  }
+
+  get head(): HistoryNode {
+    return this.#head;
+  }
+
+  get current(): HistoryNode {
+    return this.#current;
+  }
+
+  /** 지금 들고 있는 기록 수 (0번 포함) */
+  get size(): number {
+    return this.#size;
+  }
+
+  /**
+   * current 뒤에 새 기록을 붙이고 current를 옮긴다.
+   * - 뒤로 간 상태였다면 앞쪽(redo) 기록은 끊는다 (갈림길 정책). 끊은 만큼 size도 뺀다.
+   * - 50개를 넘으면 head를 다음으로 옮긴다 (새 맨 앞이 새 바닥).
+   */
+  push(entry: HistoryEntry): void {
+    // [AI Note]: 끊은 기록 수를 size에서 빼지 않으면 한도 근처에서 head를 너무 일찍 빼는 버그가 난다 (B17).
+    let cut = this.#current.next;
+    while (cut !== null) {
+      const after = cut.next;
+      cut.prev = null;
+      cut.next = null;
+      this.#size--;
+      cut = after;
+    }
+    const node: HistoryNode = { entry, prev: this.#current, next: null };
+    this.#current.next = node;
+    this.#current = node;
+    this.#size++;
+    if (this.#size > HISTORY_LIMIT) this.#dropHead();
+  }
+
+  /** 한 칸 뒤로. 이동한 기록을 돌려주고, 처음(0번이 바닥)이면 아무 일 없이 `null` (경계 무시) */
+  back(): HistoryEntry | null {
+    const prev = this.#current.prev;
+    if (prev === null) return null;
+    this.#current = prev;
+    return prev.entry;
+  }
+
+  /** 한 칸 앞으로. 이동한 기록을 돌려주고, 끝이면 아무 일 없이 `null` (경계 무시) */
+  forward(): HistoryEntry | null {
+    const next = this.#current.next;
+    if (next === null) return null;
+    this.#current = next;
+    return next.entry;
+  }
+
+  #dropHead(): void {
+    const old = this.#head;
+    const second = old.next!;
+    second.prev = null;
+    old.next = null;
+    this.#head = second;
+    this.#size--;
+  }
+}

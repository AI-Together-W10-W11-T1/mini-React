+function makeContainer(): HTMLElement {
+  const box = document.createElement('div');
+  box.id = 'root-box';
+  box.className = 'box';
+  document.body.appendChild(box);
+  mounted.push(box);
+  return box;
+}
+
+afterEach(() => {
+  mounted.splice(0).forEach((box) => box.remove());
+  vi.restoreAllMocks();

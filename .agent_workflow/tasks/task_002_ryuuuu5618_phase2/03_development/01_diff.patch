+    let renders = 0; // 바깥 변수로 센다 (상태가 아님)
+    function Counter(): VNode {
+      renders += 1;
+      const [count, setCount] = useState(0);
+      return h(
+        'main',
+        null,
+        h('p', { 'data-testid': 'value' }, count),
+        h(
+          'button',
+          {
+            'data-testid': 'plus3',
+            onClick: () => {
+              setCount((c) => c + 1);
+              setCount((c) => c + 1);
+              setCount((c) => c + 1);
+            },
+          },
+          '+3',
+        ),
+        h('button', { 'data-testid': 'same', onClick: () => setCount(count) }, '그대로'),
+      );
+    }
+    const box = makeContainer();
+    render(Counter, box);

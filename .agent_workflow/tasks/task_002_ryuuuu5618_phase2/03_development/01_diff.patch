+import { h, useEffect, useMemo, useState } from '@mini-react/react';
+import type { VNode } from '@mini-react/shared';
+import { CounterPanel } from './components/CounterPanel';
+import { GreetingPanel } from './components/GreetingPanel';
+import { LogPanel } from './components/LogPanel';
+import { TodoPanel } from './components/TodoPanel';
+import { counts, engine } from './counts';
+import { addTodo, moveTodo, removeTodo, toggleTodo } from './todoOps';
+import type { TodoList } from './todoOps';
+
+const EMPTY_LIST: TodoList = { items: [], nextId: 1 };
+
+// 기록판의 빈 <span>(effect · patch 칸)에 글자를 직접 쓴다. 이 칸들은 VNode 자식이 없어서 diff와 충돌하지 않는다.
+function writeLog(testId: string, value: number): void {
+  const cell = document.querySelector(`[data-testid="${testId}"]`);
+  if (cell !== null) cell.textContent = String(value);
+}
+
+// [AI Note]: 루트 컴포넌트. 모든 useState · useEffect · useMemo는 이 파일에서만 부른다 (P2-07 · P2-08).
+// 자식은 props만 받는 순수 함수이고, 버튼을 누르면 루트가 내려 준 함수를 불러 루트가 setter로 상태를 바꾼다 (Lifting State Up).
+export function App(): VNode {
+  counts.renderRuns += 1;
+  const [count, setCount] = useState(0);
+  const [name, setName] = useState('');
+  const [draft, setDraft] = useState('');
+  const [todoList, setTodoList] = useState<TodoList>(EMPTY_LIST);
+
+  // 요약("전체 n개 · 완료 m개")은 목록(items)이 바뀔 때만 다시 계산한다. 계산 횟수는 상태가 아닌 바깥 변수로 센다.
+  const summary = useMemo(() => {
+    counts.memoRuns += 1;
+    return { total: todoList.items.length, done: todoList.items.filter((t) => t.done).length };
+  }, [todoList.items]);
+
+  // 탭 제목: 카운터가 바뀔 때만(의존성 [count]) patch 직후에 실행된다. 이 effect가 도는 횟수가 기록판의 effect 횟수다.
+  useEffect(() => {
+    counts.effectRuns += 1;
+    document.title = `카운터 ${count} - Phase 2`;
+  }, [count]);
+
+  // 의존성 생략 = 매 렌더 뒤(patch 직후) 실행: 렌더가 끝난 뒤에야 알 수 있는 값(effect 횟수 · 마지막 update의 patch 줄 수)을 기록판 칸에 쓴다.
+  // 위 effect가 먼저 선언돼 있어서 이 effect가 읽는 effectRuns는 이미 이번 렌더 값이다.
+  useEffect(() => {
+    const patches = engine.lastPatches();
+    writeLog('log-effect', counts.effectRuns);
+    writeLog('log-patch', patches.length);
+    writeLog('log-patch-events', patches.filter((p) => p.kind === 'SET_EVENT').length);
+  });
+
+  const onAdd = () => {
+    const text = draft.trim();
+    if (text === '') return; // 빈 글 · 공백만: 상태 그대로 (렌더 0번)
+    // 한 번의 [추가] = setter 두 번 (렌더 2번): 목록에 붙이고, 입력창을 비운다
+    setTodoList((list) => addTodo(list, text));
+    setDraft('');
+  };
+
+  return h(
+    'main',
+    { class: 'app' },
+    h('h1', null, 'Phase 2 검증 페이지'),
+    h(
+      'div',
+      { class: 'panels' },
+      h(CounterPanel, {
+        count,
+        // [+1]: 함수형 setter 한 번
+        onPlus1: () => setCount((c) => c + 1),
+        // [+3]: 함수형 setter 세 번 연달아 → 3 증가, 렌더도 3번 (즉시 동기 정책)
+        onPlus3: () => {
+          setCount((c) => c + 1);
+          setCount((c) => c + 1);
+          setCount((c) => c + 1);
+        },
+        // [그대로]: 지금과 같은 값 → 다시 그리지 않음
+        onSame: () => setCount(count),
+      }),
+      h(GreetingPanel, {
+        name,
+        onNameInput: (event: Event) => setName((event.target as HTMLInputElement).value),
+      }),
+      h(TodoPanel, {
+        items: todoList.items,
+        total: summary.total,
+        done: summary.done,
+        draft,
+        onDraftInput: (event: Event) => setDraft((event.target as HTMLInputElement).value),
+        onAdd,
+        onToggle: (id: string) => setTodoList((list) => toggleTodo(list, id)),
+        // [위로] · [아래로]: 순서만 바꾼 새 목록. 경계면 같은 목록이라 다시 그리지 않는다
+        onMove: (id: string, delta: -1 | 1) => setTodoList((list) => moveTodo(list, id, delta)),
+        onRemove: (id: string) => setTodoList((list) => removeTodo(list, id)),
+      }),
+      h(LogPanel, { renderRuns: counts.renderRuns, memoRuns: counts.memoRuns }),
+    ),
+  );
+}
diff --git a/fixtures/phase2-app/__tests__/rootOnlyHooks.test.ts b/fixtures/phase2-app/__tests__/rootOnlyHooks.test.ts
new file mode 100644
index 0000000..8e281a0
--- /dev/null
+++ b/fixtures/phase2-app/__tests__/rootOnlyHooks.test.ts
@@ -0,0 +1,93 @@
+/// <reference types="vite/client" />
+import { describe, expect, it } from 'vitest';
+
+// [AI Note]: T-16 코드 확인 — Hook은 루트 컴포넌트(App.ts)에서만 부른다 (P2-07 · P2-08 · P2-09).
+// 자식 컴포넌트(components/*.ts)는 props만 받는 순수 함수라 Hook도 DOM(document · window)도 쓰지 않는다.
+// 소스 파일을 글로 읽어 검사한다. 검사기(findViolations)가 정말 위반을 잡는지 일부러 틀린 소스로도 확인한다.
+
+// [AI Note]: 소스를 글(?raw)로 가져온다 — node:fs를 쓰지 않아 @types/node 없이도 타입 검사를 통과한다.
+const topLevel = import.meta.glob<string>('../*.ts', { query: '?raw', import: 'default', eager: true });
+const components = import.meta.glob<string>('../components/*.ts', { query: '?raw', import: 'default', eager: true });
+const sourceOf = (map: Record<string, string>, file: string): string => {
+  const found = map[file];
+  if (found === undefined) throw new Error(`${file} 소스를 찾지 못했습니다`);
+  return found;
+};
+
+function stripComments(source: string): string {
+  return source.replace(/\/\*[\s\S]*?\*\//g, '').replace(/\/\/.*$/gm, '');
+}
+
+/** 주석 · 문자열 안의 단어는 호출이 아니므로 먼저 지우고 본다 */
+function stripNoise(source: string): string {
+  return stripComments(source)
+    .replace(/'(?:\\.|[^'\\\n])*'/g, "''")
+    .replace(/"(?:\\.|[^"\\\n])*"/g, '""')
+    .replace(/`(?:\\.|[^`\\])*`/g, '``');
+}
+
+/** Hook 호출 · import, DOM 접근(document · window), 엔진 내부 접근이 있으면 이유 목록을 돌려준다 */
+function findViolations(source: string): string[] {
+  const code = stripNoise(source);
+  const found: string[] = [];
+  for (const hook of ['useState', 'useEffect', 'useMemo']) {
+    if (new RegExp(`\\b${hook}\\b`).test(code)) found.push(`${hook} 사용`);
+  }
+  if (/\bdocument\b/.test(code)) found.push('document 접근');
+  if (/\bwindow\b/.test(code)) found.push('window 접근');
+  if (/\bsetHookDispatcher\b/.test(code)) found.push('setHookDispatcher 접근');
+  // import 경로는 문자열이라 주석만 지운 글에서 본다
+  if (/@mini-react\/(react-dom|react-dom-bindings|react-reconciler|scheduler)/.test(stripComments(source))) found.push('엔진 패키지 import');
+  return found;
+}
+
+const componentFiles = Object.keys(components).map((path) => path.replace('../components/', ''));
+
+describe('검사기 자체 확인 — 위반을 잡는다', () => {
+  it('Hook 호출 · document · window · 엔진 import를 각각 잡는다', () => {
+    expect(findViolations("import { h, useState } from '@mini-react/react';")).toEqual(['useState 사용']);
+    expect(findViolations('const x = useEffect(() => {}, []);')).toEqual(['useEffect 사용']);
+    expect(findViolations('const y = useMemo(() => 1, []);')).toEqual(['useMemo 사용']);
+    expect(findViolations('document.title = "x";')).toEqual(['document 접근']);
+    expect(findViolations('window.scrollTo(0, 0);')).toEqual(['window 접근']);
+    expect(findViolations("import { render } from '@mini-react/react-dom';")).toEqual(['엔진 패키지 import']);
+  });
+
+  it('주석 · 문자열 안의 단어는 위반으로 세지 않는다', () => {
+    expect(findViolations("// useState는 루트에서만\nconst a = 'document';\nconst b = `window ${1}`;")).toEqual([]);
+  });
+});
+
+describe('T-16 코드 확인 — 루트(App.ts)만 Hook을 쓴다', () => {
+  it('자식 컴포넌트 파일이 있다 (CounterPanel · GreetingPanel · TodoPanel · TodoRow · LogPanel)', () => {
+    expect([...componentFiles].sort()).toEqual(['CounterPanel.ts', 'GreetingPanel.ts', 'LogPanel.ts', 'TodoPanel.ts', 'TodoRow.ts']);
+  });
+
+  for (const name of componentFiles) {
+    it(`components/${name}: Hook · DOM 접근 · 엔진 내부 접근이 없다 (props만 받는 순수 함수)`, () => {
+      expect(findViolations(sourceOf(components, `../components/${name}`))).toEqual([]);
+    });
+  }
+
+  it('App.ts가 useState · useEffect · useMemo를 모두 부른다 (루트가 상태 · Hook을 가진다)', () => {
+    const app = stripNoise(sourceOf(topLevel, '../App.ts'));
+    for (const hook of ['useState', 'useEffect', 'useMemo']) {
+      expect(new RegExp(`\\b${hook}\\s*(<[^>(]*>)?\\(`).test(app), `${hook} 호출`).toBe(true);
+    }
+  });
+
+  it('App.ts 밖의 소스(todoOps · counts · main)는 Hook을 쓰지 않는다', () => {
+    for (const file of ['todoOps.ts', 'counts.ts', 'main.ts']) {
+      const code = stripNoise(sourceOf(topLevel, `../${file}`));
+      for (const hook of ['useState', 'useEffect', 'useMemo']) {
+        expect(new RegExp(`\\b${hook}\\b`).test(code), `${file}의 ${hook}`).toBe(false);
+      }
+    }
+  });
+
+  it('상태가 아닌 바깥 변수(counts)로만 횟수를 센다: 자식이 아니라 App.ts만 올린다', () => {
+    for (const name of componentFiles) {
+      expect(stripNoise(sourceOf(components, `../components/${name}`))).not.toMatch(/counts\.\w+\s*(\+=|\+\+|=[^=])/);
+    }
+  });
+});
diff --git a/fixtures/phase2-app/__tests__/todoOps.test.ts b/fixtures/phase2-app/__tests__/todoOps.test.ts

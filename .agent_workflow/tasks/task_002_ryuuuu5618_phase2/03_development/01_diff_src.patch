+    Object.values(v as object).forEach(deepFreeze);
+  }
+  return v;
+}
+
+function run(oldTree: AreaChildren, newTree: AreaChildren): Patch[] {
+  const patches = diff(deepFreeze(oldTree), deepFreeze(newTree));

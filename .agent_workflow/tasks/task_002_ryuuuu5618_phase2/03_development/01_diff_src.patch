+    ]);
+  });
+
+  it('value로 쓸 수 없는 값(null · undefined · boolean · 함수)은 없음', () => {
+    expect(diff([el('input', {})], [el('input', { value: null })])).toEqual([]);
+    expect(diff([el('input', {})], [el('input', { value: undefined })])).toEqual([]);
+    expect(diff([el('input', {})], [el('input', { value: true })])).toEqual([]);

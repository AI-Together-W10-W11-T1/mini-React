+++ b/e2e/phase2-helpers.ts
@@ -0,0 +1,159 @@
+import type { Page } from '@playwright/test';
+import { holdNodes as holdNodes1, sameNode as sameNode1, isStillConnected as isStillConnected1, test, expect, expectNoConsoleWarnings } from './phase1-helpers';
+import type { NodeSpec } from './phase1-helpers';
+
+// [AI Note]: Phase 2 e2e 공통 도구. `test`는 phase1-helpers의 확장(콘솔 error 한 건이라도 있으면 실패, 선언하지 않은 dialog도 실패)을
+// 그대로 다시 내보낸다. Phase 2 검증 페이지에는 alert가 없으므로 captureAlert를 쓰는 시나리오가 없다.
+export { test, expect, expectNoConsoleWarnings };
+export type { NodeSpec };
+
+export const URL = '/phase2-app/';
+/** 영역 상자 `data-testid` (index.html의 보이지 않는 감싸개 <div>, 안에 App() 결과 <main> 하나) */
+export const AREA = 'app-root';
+
+/** 노드를 붙잡아 둔다 (영역 상자는 app-root) */
+export function holdNodes(page: Page, nodes: Record<string, NodeSpec>): Promise<void> {
+  return holdNodes1(page, nodes, { area: AREA });
+}
+
+/** 붙잡아 둔 노드가 지금 spec이 가리키는 노드와 같은 참조(`===`)인가 */
+export function sameNode(page: Page, name: string, spec: NodeSpec): Promise<boolean> {
+  return sameNode1(page, name, spec, { area: AREA });
+}
+
+export function isStillConnected(page: Page, name: string): Promise<boolean> {
+  return isStillConnected1(page, name);
+}
+
+// ---------------------------------------------------------------------------
+// DOM 변경 관찰: 본문과 기록판(`log-*`)을 따로 센다
+// ---------------------------------------------------------------------------
+
+export interface MutationCounts {
+  characterData: number;
+  attributes: number;
+  childList: number;
+  total: number;
+  /** `종류:target` 목록. target은 요소면 태그 이름, 글자 · 주석 노드면 `#text` · `#comment` */
+  targets: string[];
+}
+
+export interface AppMutations {
+  /** 기록판(`data-testid`가 `log-`로 시작하는 요소) 안을 뺀 나머지 */
+  body: MutationCounts;
+  /** 기록판 안 (effect · patch 칸은 effect가 textContent로 직접 쓰므로 본문과 섞지 않는다) */
+  log: MutationCounts;
+}
+
+export interface AppWatcher {
+  /** 지금까지 모인 기록을 본문 · 기록판으로 나눠 요약하고 비운다 */
+  take(): Promise<AppMutations>;
+}
+
+/** `app-root`(또는 `testId`로 고른 그 안의 칸)에 MutationObserver를 심는다 */
+export async function watchApp(page: Page, testId: string = AREA): Promise<AppWatcher> {
+  const slot = `__appMut_${testId}`;
+  await page.evaluate(
+    ({ id, key }) => {
+      const target = document.querySelector(`[data-testid="${id}"]`);
+      if (target === null) throw new Error(`data-testid="${id}"가 없다`);
+      const store = { observer: null as MutationObserver | null, records: [] as MutationRecord[] };
+      store.observer = new MutationObserver((list) => store.records.push(...list));
+      store.observer.observe(target, { subtree: true, childList: true, attributes: true, characterData: true });
+      (window as unknown as Record<string, unknown>)[key] = store;
+    },
+    { id: testId, key: slot },
+  );
+  return {
+    async take() {
+      return page.evaluate((key) => {
+        const store = (window as unknown as Record<string, { observer: MutationObserver; records: MutationRecord[] }>)[key];
+        const records = [...store.records, ...store.observer.takeRecords()];
+        store.records.length = 0;
+        const empty = (): MutationCounts => ({ characterData: 0, attributes: 0, childList: 0, total: 0, targets: [] });
+        const out = { body: empty(), log: empty() };
+        const describe = (n: Node): string =>
+          n.nodeType === Node.TEXT_NODE ? '#text' : n.nodeType === Node.COMMENT_NODE ? '#comment' : (n as Element).localName;
+        for (const r of records) {
+          const el = r.target.nodeType === Node.ELEMENT_NODE ? (r.target as Element) : r.target.parentElement;
+          const side = el !== null && el.closest('[data-testid^="log-"]') !== null ? out.log : out.body;
+          side[r.type] += 1;
+          side.total += 1;
+          side.targets.push(`${r.type}:${describe(r.target)}`);
+        }
+        return out;
+      }, slot);
+    },
+  };
+}
+
+// ---------------------------------------------------------------------------
+// 읽기 도우미
+// ---------------------------------------------------------------------------
+
+/** 가로 스크롤이 없는가 (문서 폭이 화면 폭 이하) */
+export function noHorizontalScroll(page: Page): Promise<boolean> {
+  return page.evaluate(() => document.documentElement.scrollWidth <= document.documentElement.clientWidth);
+}
+
+/** 기록판 칸(`log-*`)의 숫자. 칸에는 숫자만 들어 있다 */
+export async function logNumber(page: Page, id: 'log-render' | 'log-effect' | 'log-memo' | 'log-patch' | 'log-patch-events'): Promise<number> {
+  const text = (await page.getByTestId(id).textContent()) ?? '';
+  return Number(text);
+}
+
+/** 지금까지 `App()`이 실행된 횟수 (기록판 `log-render` 칸) */
+export function renderCount(page: Page): Promise<number> {
+  return logNumber(page, 'log-render');
+}
+
+/** `[count]` effect가 실행된 횟수 (기록판 `log-effect` 칸) */
+export function effectCount(page: Page): Promise<number> {
+  return logNumber(page, 'log-effect');
+}
+
+/** ③ 목록의 `useMemo`가 다시 계산한 횟수 (기록판 `log-memo` 칸) */
+export function memoCount(page: Page): Promise<number> {
+  return logNumber(page, 'log-memo');
+}
+
+/** 마지막 update의 patch 전체 줄 수 (`log-patch`) */
+export function patchCount(page: Page): Promise<number> {
+  return logNumber(page, 'log-patch');
+}
+
+/** 마지막 update의 patch 중 이벤트 교체(`SET_EVENT`) 줄 수 (`log-patch-events`) */
+export function patchEventCount(page: Page): Promise<number> {
+  return logNumber(page, 'log-patch-events');
+}
+
+/** `counter-value` 칸의 글 (숫자만 들어 있다) */
+export async function counterText(page: Page): Promise<string> {
+  return (await page.getByTestId('counter-value').textContent()) ?? '';
+}
+
+/** 할 일 입력창에 글을 쓰고 [추가]를 누른다 */
+export async function addTodo(page: Page, text: string): Promise<void> {
+  await page.getByTestId('todo-input').fill(text);
+  await page.getByTestId('todo-add').click();
+}
+
+/** 항목 줄 `<li>`를 가리키는 선택자 (`data-id`) */
+export function itemSel(id: string): string {
+  return `[data-testid="todo-item"][data-id="${id}"]`;
+}
+
+/** 항목 줄 안의 요소를 가리키는 선택자 (예: `inItem('todo-1', 'todo-remove')`) */
+export function inItem(id: string, testId: string): string {
+  return `${itemSel(id)} [data-testid="${testId}"]`;
+}
+
+/** 화면에 보이는 항목 글자들 (위에서 아래 순서) */
+export function itemTexts(page: Page): Promise<string[]> {
+  return page.getByTestId('todo-text').allTextContents();
+}
+
+/** 화면에 보이는 항목 id들 (위에서 아래 순서) */
+export function itemIds(page: Page): Promise<string[]> {
+  return page.getByTestId('todo-item').evaluateAll((els) => els.map((el) => el.getAttribute('data-id') ?? ''));
+}
diff --git a/e2e/phase2-input.spec.ts b/e2e/phase2-input.spec.ts
new file mode 100644
index 0000000..9a19631
--- /dev/null
+++ b/e2e/phase2-input.spec.ts
@@ -0,0 +1,66 @@
+import { test, expect, URL, holdNodes, sameNode } from './phase2-helpers';
+
+// [AI Note]: QA-5 · QA-6 · QA-7 (② 입력창). 입력은 사용자처럼 fill · pressSequentially, 포커스를 옮기지 않고 다른 상태를 바꿔야 할 때만 el.click()을 쓴다.
+
+const NAME = '[data-testid="name-input"]';
+
+test('QA-5 이름 입력창에 `민수`를 입력하면 인사 글이 `안녕하세요, 민수님`이 되고(D-01), 지우면 다시 안내 문구가 된다', async ({ page }) => {
+  await page.goto(URL);
+  const input = page.getByTestId('name-input');
+  const greeting = page.getByTestId('greeting-text');
+  await expect(greeting).toHaveText('이름을 입력해 주세요');
+
+  await input.fill('민수');
+  await expect(greeting).toHaveText('안녕하세요, 민수님');
+  await expect(input).toHaveValue('민수');
+
+  await input.fill('');
+  await expect(greeting).toHaveText('이름을 입력해 주세요');
+  await expect(input).toHaveValue('');
+});
+
+test('QA-6 `가다`를 입력해 두고 커서를 `가`와 `다` 사이로 옮겨 `나`를 입력하면 값 `가나다` · 커서 2 · 포커스 유지 · 같은 입력창이다', async ({ page }) => {
+  await page.goto(URL);
+  const input = page.getByTestId('name-input');
+  await input.click();
+  await input.pressSequentially('가다');
+  await holdNodes(page, { input: NAME });
+
+  await page.keyboard.press('ArrowLeft');
+  await input.pressSequentially('나');
+
+  await expect(input).toHaveValue('가나다');
+  await expect(page.getByTestId('greeting-text')).toHaveText('안녕하세요, 가나다님');
+  const state = await page.evaluate(() => {
+    const el = document.querySelector('[data-testid="name-input"]') as HTMLInputElement;
+    return { start: el.selectionStart, end: el.selectionEnd, focused: document.activeElement === el };
+  });
+  // 커서가 `나` 바로 뒤(2)에 있고, 입력할 때마다 값이 다시 대입되지 않아 포커스도 그대로다
+  expect(state).toEqual({ start: 2, end: 2, focused: true });
+  expect(await sameNode(page, 'input', NAME)).toBe(true);
+});
+
+test('QA-7 입력창에 포커스를 둔 채 다른 상태(카운터)가 바뀌어도 입력창 노드 · 값 · 포커스 · 커서가 그대로다', async ({ page }) => {
+  await page.goto(URL);
+  const input = page.getByTestId('name-input');
+  await input.click();
+  await input.pressSequentially('영희');
+  await page.keyboard.press('ArrowLeft');
+  await holdNodes(page, { input: NAME });
+  const before = await page.evaluate(() => (document.querySelector('[data-testid="name-input"]') as HTMLInputElement).selectionStart);
+  expect(before).toBe(1);
+
+  // el.click()은 포커스를 옮기지 않는다
+  await page.evaluate(() => {
+    (document.querySelector('[data-testid="counter-plus1"]') as HTMLElement).click();
+    (document.querySelector('[data-testid="counter-plus3"]') as HTMLElement).click();
+  });
+
+  await expect(page.getByTestId('counter-value')).toHaveText('4');
+  const state = await page.evaluate(() => {
+    const el = document.querySelector('[data-testid="name-input"]') as HTMLInputElement;
+    return { value: el.value, start: el.selectionStart, focused: document.activeElement === el };
+  });
+  expect(state).toEqual({ value: '영희', start: 1, focused: true });
+  expect(await sameNode(page, 'input', NAME)).toBe(true);
+});
diff --git a/e2e/phase2-log.spec.ts b/e2e/phase2-log.spec.ts
new file mode 100644
index 0000000..04eab8d
--- /dev/null
+++ b/e2e/phase2-log.spec.ts
@@ -0,0 +1,236 @@
+import {
+  test,
+  expect,
+  URL,
+  holdNodes,
+  sameNode,
+  watchApp,
+  addTodo,
+  itemSel,
+  inItem,
+  counterText,
+  renderCount,
+  effectCount,
+  memoCount,
+  patchCount,
+  patchEventCount,
+} from './phase2-helpers';
+import type { Page } from '@playwright/test';
+
+// [AI Note]: QA-12 (useMemo) · QA-14 ~ QA-18 (기록판 · 탭 제목 effect · 이벤트 중복 없음 · 참조 유지). 횟수는 기록판 칸(log-*)에서 읽는다.
+
+test('QA-12 목록이 안 바뀌면 memo를 다시 계산하지 않고(a), 목록이 바뀌면 한 번씩 다시 계산하며(b), [추가] 한 번에는 1번만 계산한다(c)', async ({ page }) => {
+  await page.goto(URL);
+  await addTodo(page, '사과');
+  await addTodo(page, '배');
+  const summary = page.getByTestId('todo-summary');
+  await expect(summary).toHaveText('전체 2개 · 완료 0개');
+
+  // (a) 목록과 상관없는 상태만 바뀐다: 카운터 · 이름 · 할 일 입력창(draft)
+  let m = await memoCount(page);
+  await page.getByTestId('counter-plus1').click();
+  await page.getByTestId('name-input').fill('민수');
+  await page.getByTestId('todo-input').fill('글');
+  expect(await memoCount(page)).toBe(m);
+  await expect(summary).toHaveText('전체 2개 · 완료 0개');
+  await page.getByTestId('todo-input').fill('');
+
+  // (b) 체크 · [위로] · 삭제: 한 동작마다 1씩, 요약이 맞다
+  m = await memoCount(page);
+  await page.locator(inItem('todo-1', 'todo-check')).click();
+  expect(await memoCount(page)).toBe(m + 1);
+  await expect(summary).toHaveText('전체 2개 · 완료 1개');
+  await page.locator(inItem('todo-2', 'todo-up')).click();
+  expect(await memoCount(page)).toBe(m + 2);
+  await expect(summary).toHaveText('전체 2개 · 완료 1개');
+  await page.locator(inItem('todo-2', 'todo-remove')).click();
+  expect(await memoCount(page)).toBe(m + 3);
+  await expect(summary).toHaveText('전체 1개 · 완료 1개');
+
+  // (c) [추가] 한 번에 memo 횟수가 정확히 1 늘고(렌더 2번 중 목록이 바뀐 한 번만 다시 계산) 요약이 맞다
+  m = await memoCount(page);
+  await addTodo(page, '감');
+  expect(await memoCount(page)).toBe(m + 1);
+  await expect(summary).toHaveText('전체 2개 · 완료 1개');
+});
+
+/** 기록판 세 칸(render · effect · memo) */
+async function triple(page: Page): Promise<[number, number, number]> {
+  return [await renderCount(page), await effectCount(page), await memoCount(page)];
+}
+
+test('QA-14 기록판 (render · effect · memo): 로드 1·1·1 → [+1] 2·2·1 → 이름 3·2·1 → [그대로] 3·2·1 → [+3] 6·5·1 → 할 일 입력 + [추가] 9·5·2', async ({ page }) => {
+  await page.goto(URL);
+  expect(await triple(page)).toEqual([1, 1, 1]); // (1) 로드 직후
+
+  await page.getByTestId('counter-plus1').click(); // (2) 카운터가 바뀌어 [count] effect가 다시 돎
+  expect(await triple(page)).toEqual([2, 2, 1]);
+
+  await page.getByTestId('name-input').fill('가'); // (3) 카운터 그대로라 effect는 안 돎
+  expect(await triple(page)).toEqual([3, 2, 1]);
+
+  await page.getByTestId('counter-same').click(); // (4) 같은 값, 렌더 0번
+  expect(await triple(page)).toEqual([3, 2, 1]);
+
+  await page.getByTestId('counter-plus3').click(); // (5) 렌더 3번 · 카운터가 3번 바뀌어 effect도 3번
+  expect(await triple(page)).toEqual([6, 5, 1]);
+
+  await page.getByTestId('todo-input').fill('나'); // (6) 글자 입력 렌더 1번 + [추가] 렌더 2번, memo는 목록이 바뀐 한 번만
+  await page.getByTestId('todo-add').click();
+  expect(await triple(page)).toEqual([9, 5, 2]);
+});
+
+test('QA-15 patch 줄 수: 이벤트 교체 줄 = 핸들러 달린 요소 수(6 → 14), 전체 − 이벤트 = DOM을 바꾸는 줄 2(카운터 글자 · 렌더 횟수 글자)로 항목이 늘어도 같다', async ({ page }) => {
+  await page.goto(URL);
+  expect([await patchCount(page), await patchEventCount(page)]).toEqual([0, 0]); // 로드 직후
+
+  await page.getByTestId('counter-plus1').click();
+  // 핸들러 달린 요소 6개: [+1] · [+3] · [그대로] · 이름 입력창 · 할 일 입력창 · [추가]
+  expect(await patchEventCount(page)).toBe(6);
+  expect((await patchCount(page)) - (await patchEventCount(page))).toBe(2);
+
+  await addTodo(page, '사과');
+  await addTodo(page, '배');
+  await page.getByTestId('counter-plus1').click();
+  // 6 + 항목마다 4(체크 · [위로] · [아래로] · [삭제]) × 2 = 14
+  expect(await patchEventCount(page)).toBe(14);
+  expect((await patchCount(page)) - (await patchEventCount(page))).toBe(2);
+});
+
+test('QA-16 탭 제목: `카운터 N - Phase 2`, 이름 입력에는 그대로(effect 의존성 [count]), 제목은 DOM이 반영된 뒤 바뀐다', async ({ page }) => {
+  // document.title을 쓰는 순간 화면의 카운터 글이 이미 새 값인지(effect는 patch 직후) 기록한다
+  await page.addInitScript(() => {
+    const seen: string[] = [];
+    (window as unknown as { __titleWrites: string[] }).__titleWrites = seen;
+    const desc = Object.getOwnPropertyDescriptor(Document.prototype, 'title');
+    if (desc === undefined || desc.set === undefined || desc.get === undefined) return;
+    const { get, set } = desc;
+    Object.defineProperty(document, 'title', {
+      configurable: true,
+      get() {
+        return get.call(document);
+      },
+      set(value: string) {
+        const counter = document.querySelector('[data-testid="counter-value"]')?.textContent ?? '(없음)';
+        seen.push(`${value} | 화면 카운터 ${counter}`);
+        set.call(document, value);
+      },
+    });
+  });
+  await page.goto(URL);
+  expect(await page.title()).toBe('카운터 0 - Phase 2');
+
+  await page.getByTestId('counter-plus1').click();
+  expect(await page.title()).toBe('카운터 1 - Phase 2');
+
+  const effects = await effectCount(page);
+  await page.getByTestId('name-input').fill('민수');
+  expect(await page.title()).toBe('카운터 1 - Phase 2');
+  expect(await effectCount(page)).toBe(effects);
+
+  await page.getByTestId('counter-plus3').click();
+  expect(await page.title()).toBe('카운터 4 - Phase 2');
+
+  const writes = await page.evaluate(() => (window as unknown as { __titleWrites: string[] }).__titleWrites);
+  expect(writes).toEqual([
+    '카운터 0 - Phase 2 | 화면 카운터 0',
+    '카운터 1 - Phase 2 | 화면 카운터 1',
+    '카운터 2 - Phase 2 | 화면 카운터 2',
+    '카운터 3 - Phase 2 | 화면 카운터 3',
+    '카운터 4 - Phase 2 | 화면 카운터 4',
+  ]);
+});
+
+test('QA-17 렌더를 20번 넘게 일으킨 뒤에도 [+1] 한 번은 정확히 +1, [삭제] 한 번은 한 줄이며, (요소, 이벤트 이름)마다 addEventListener는 1번을 넘지 않는다', async ({ page }) => {
+  // 요소(Element)마다 이벤트 이름별 addEventListener 호출 수를 센다
+  await page.addInitScript(() => {
+    const counts = new WeakMap<object, Record<string, number>>();
+    const pairs: Array<{ el: WeakRef<object>; event: string }> = [];
+    const original = EventTarget.prototype.addEventListener;
+    EventTarget.prototype.addEventListener = function (this: EventTarget, type: string, ...rest: unknown[]) {
+      if (this instanceof Element) {
+        const record = counts.get(this) ?? {};
+        if (!counts.has(this)) counts.set(this, record);
+        record[type] = (record[type] ?? 0) + 1;
+        pairs.push({ el: new WeakRef(this), event: type });
+      }
+      return (original as (...args: unknown[]) => void).call(this, type, ...rest);
+    } as typeof EventTarget.prototype.addEventListener;
+    (window as unknown as { __maxListeners: () => number }).__maxListeners = () => {
+      let max = 0;
+      for (const { el, event } of pairs) {
+        const target = el.deref();
+        if (target === undefined) continue;
+        max = Math.max(max, counts.get(target)?.[event] ?? 0);
+      }
+      return max;
+    };
+  });
+  await page.goto(URL);
+
+  // 렌더를 20번 넘게: 이름 입력 · 할 일 추가 · 체크 · 이동 (카운터는 건드리지 않는다)
+  await page.getByTestId('name-input').pressSequentially('가나다라마바사아자차');
+  for (const text of ['가', '나', '다']) await addTodo(page, text);
+  await page.locator(inItem('todo-1', 'todo-check')).click();
+  await page.locator(inItem('todo-3', 'todo-up')).click();
+  await page.locator(inItem('todo-3', 'todo-down')).click();
+  expect(await renderCount(page)).toBeGreaterThan(20);
+  expect(await counterText(page)).toBe('0');
+
+  await page.getByTestId('counter-plus1').click(); // 한 번
+  expect(await counterText(page)).toBe('1');
+
+  const before = await page.getByTestId('todo-item').count();
+  await page.locator(inItem('todo-2', 'todo-remove')).click(); // 한 번
+  expect(await page.getByTestId('todo-item').count()).toBe(before - 1);
+  await expect(page.locator(itemSel('todo-2'))).toHaveCount(0);
+
+  expect(await page.evaluate(() => (window as unknown as { __maxListeners: () => number }).__maxListeners())).toBe(1);
+});
+
+test('QA-18 [+1] · 이름 입력 · 체크 뒤에 변경 대상과 관련 없는 노드는 모두 같은 참조이고, 본문 DOM 변경은 바뀐 글자 · 속성뿐이다', async ({ page }) => {
+  await page.goto(URL);
+  await addTodo(page, '가');
+  await addTodo(page, '나');
+  await addTodo(page, '다');
+  const summaryText = { sel: '[data-testid="todo-summary"]', child: 0 };
+  await holdNodes(page, {
+    plus1: '[data-testid="counter-plus1"]',
+    nameInput: '[data-testid="name-input"]',
+    todoInput: '[data-testid="todo-input"]',
+    ul: '[data-testid="todo-list"]',
+    ga: itemSel('todo-1'),
+    na: itemSel('todo-2'),
+    da: itemSel('todo-3'),
+    summaryText,
+    greeting: '[data-testid="greeting-text"]',
+  });
+  const same = async (): Promise<boolean[]> => [
+    await sameNode(page, 'plus1', '[data-testid="counter-plus1"]'),
+    await sameNode(page, 'nameInput', '[data-testid="name-input"]'),
+    await sameNode(page, 'todoInput', '[data-testid="todo-input"]'),
+    await sameNode(page, 'ul', '[data-testid="todo-list"]'),
+    await sameNode(page, 'ga', itemSel('todo-1')),
+    await sameNode(page, 'na', itemSel('todo-2')),
+    await sameNode(page, 'da', itemSel('todo-3')),
+    await sameNode(page, 'summaryText', summaryText),
+    await sameNode(page, 'greeting', '[data-testid="greeting-text"]'),
+  ];
+  const watcher = await watchApp(page);
+  await watcher.take();
+
+  await page.getByTestId('counter-plus1').click();
+  expect((await same()).every(Boolean)).toBe(true);
+  let m = (await watcher.take()).body;
+  expect([m.characterData, m.attributes, m.childList]).toEqual([1, 0, 0]); // 카운터 글자 하나뿐
+
+  await page.getByTestId('name-input').pressSequentially('민');
+  expect((await same()).every(Boolean)).toBe(true);
+  m = (await watcher.take()).body;
+  expect([m.characterData, m.attributes, m.childList]).toEqual([1, 0, 0]); // 인사 글 하나뿐 (입력창 value는 프로퍼티라 속성 기록 없음)
+
+  await page.locator(inItem('todo-2', 'todo-check')).click();
+  expect((await same()).every(Boolean)).toBe(true);
+  m = (await watcher.take()).body;
+  expect([m.characterData, m.attributes, m.childList]).toEqual([1, 1, 0]); // 그 <li> 속성 1건 + 요약 글자 1건
+});

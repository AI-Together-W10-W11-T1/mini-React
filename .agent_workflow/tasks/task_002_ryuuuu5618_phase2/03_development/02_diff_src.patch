diff --git a/e2e/phase2-perfbench.spec.ts b/e2e/phase2-perfbench.spec.ts
new file mode 100644
index 0000000..67cd239
--- /dev/null
+++ b/e2e/phase2-perfbench.spec.ts
@@ -0,0 +1,90 @@
+import { test, expect, noHorizontalScroll } from './phase2-helpers';
+
+// [AI Note]: QA-20 확장 1 성능 대시보드(`/perf-bench/`) 스모크. 숫자 값 자체(ms · 개수)는 기기마다 달라 단언하지 않는다.
+// 단언하는 것: 행이 생기는가 · 반복 횟수(준비 5 · 측정 30) · 오류 수 0 · 측정 조건 칸이 채워졌는가 · 계측 패널이 측정 영역 밖에 있는가 · 콘솔 오류 없음.
+// (콘솔 error 한 건이라도 있으면 phase1-helpers의 test가 실패시킨다.)
+
+const URL = '/perf-bench/';
+const IDS = ['B-01', 'B-02', 'B-03', 'B-04', 'B-05', 'B-06', 'B-07'] as const;
+
+test('QA-20 /perf-bench/에서 시나리오를 실행하면 B-01 ~ B-07 행이 생기고 반복 횟수(준비 5 · 측정 30) · 오류 0 · 측정 조건이 채워지며 계측 패널은 측정 영역 밖에 있다', async ({ page }) => {
+  await page.goto(URL);
+
+  // 실행 전: 행이 없고 측정 영역(bench-area)과 계측 패널(표 · 상태 · 버튼)이 따로 있다
+  await expect(page.getByTestId('bench-status')).toHaveAttribute('data-state', 'idle');
+  await expect(page.getByTestId('bench-table').locator('tbody tr')).toHaveCount(0);
+  const area = page.getByTestId('bench-area');
+  await expect(area).toHaveCount(1);
+
+  // 계측 패널은 측정 영역 밖: 표 · 상태 · 버튼 · 측정 조건 어느 것도 bench-area 안에 없다 (그 안의 DOM 변경이 측정에 들어가지 않는다)
+  for (const id of ['bench-table', 'bench-status', 'bench-run', 'bench-conditions']) {
+    expect(await area.locator(`[data-testid="${id}"]`).count(), `${id}가 측정 영역 안에 있다`).toBe(0);
+    expect(await page.getByTestId(id).evaluate((el, areaId) => !document.querySelector(`[data-testid="${areaId}"]`)!.contains(el), 'bench-area')).toBe(true);
+  }
+
+  await page.getByTestId('bench-run').click();
+  await expect(page.getByTestId('bench-status')).toHaveAttribute('data-state', 'done', { timeout: 60_000 });
+
+  // 행 7개: 이름 · 반복 횟수 · 오류 0 · 시간 칸이 있다 (숫자 값은 단언하지 않는다)
+  await expect(page.getByTestId('bench-table').locator('tbody tr')).toHaveCount(7);
+  for (const id of IDS) {
+    const row = page.getByTestId(`bench-row-${id}`);
+    await expect(row).toHaveCount(1);
+    await expect(row.locator('[data-col="name"]')).toContainText(id);
+    await expect(row.locator('[data-col="repeat"]')).toHaveText('준비 5 · 측정 30');
+    await expect(row.locator('[data-col="errors"]')).toHaveText('0');
+    await expect(row.locator('[data-col="total"]')).toContainText('/'); // p50 / p95 (값은 안 본다)
+    await expect(row.locator('[data-col="total"]')).not.toHaveText('—');
+    await expect(row.locator('[data-col="dom"]')).not.toBeEmpty();
+    await expect(row.locator('[data-col="fixture"]')).toContainText('노드');
+  }
+
+  // B-01 ~ B-05는 M-04 ~ M-06 단계 시간이 있고, B-06 · B-07은 엔진 update() 한 덩어리라 "—"로 표시하고 이유를 적는다
+  for (const id of IDS.slice(0, 5)) {
+    for (const col of ['vnode', 'diff', 'patch']) {
+      await expect(page.getByTestId(`bench-row-${id}`).locator(`[data-col="${col}"]`)).toContainText('/');
+    }
+  }
+  for (const id of ['B-06', 'B-07'] as const) {
+    for (const col of ['vnode', 'diff', 'patch']) {
+      await expect(page.getByTestId(`bench-row-${id}`).locator(`[data-col="${col}"]`)).toHaveText('—');
+    }
+  }
+
+  // 구조로 확인할 수 있는 내용: 기능 정확성 · 노드 참조 유지 칸이 채워진다 (B-01은 변경 없음 = patch 0줄)
+  for (const id of IDS) {
+    await expect(page.getByTestId(`bench-row-${id}`).locator('[data-col="correct"]')).toHaveText('일치');
+    await expect(page.getByTestId(`bench-row-${id}`).locator('[data-col="preserved"]')).toContainText('/');
+  }
+  await expect(page.getByTestId('bench-row-B-01').locator('[data-col="dom"]')).toContainText('patch 0줄');
+
+  // 측정 조건 칸이 채워진다 (브라우저 · 화면 크기 · 빌드 모드 · 반복 · 집계 단위). CPU 제한 · 기기 · M-01은 사람이 적는 칸이라 입력창으로 있다
+  const cond = page.getByTestId('bench-conditions');
+  await expect(cond.getByTestId('bench-cond-browser')).not.toBeEmpty();
+  await expect(cond.getByTestId('bench-cond-browser')).toContainText(/chrom/i);
+  await expect(cond.getByTestId('bench-cond-viewport')).toContainText('×');
+  await expect(cond.getByTestId('bench-cond-build')).not.toBeEmpty();
+  await expect(cond.getByTestId('bench-cond-reps')).toContainText('준비 5');
+  await expect(cond.getByTestId('bench-cond-reps')).toContainText('측정 30');
+  await expect(cond.getByTestId('bench-cond-timer')).toContainText('해상도');
+  await expect(cond.getByTestId('bench-cond-unit')).not.toBeEmpty();
+  await expect(cond.getByTestId('bench-cond-cpu')).toBeEditable();
+  await expect(cond.getByTestId('bench-cond-device')).toBeEditable();
+  await expect(page.getByTestId('bench-m01')).toBeEditable();
+
+  // 화면 시간(M-07)이 페인트 완료가 아님을 표에 적었다
+  await expect(page.getByTestId('bench-notes')).toContainText('화면 표시');
+
+  expect(await noHorizontalScroll(page)).toBe(true);
+});
+
+test('QA-20 다시 실행해도 행이 쌓이지 않고 7개로 바뀐다 (실행 중에는 버튼이 잠긴다)', async ({ page }) => {
+  await page.goto(URL);
+  await page.getByTestId('bench-run').click();
+  await expect(page.getByTestId('bench-run')).toBeDisabled(); // 실행 중에는 잠긴다
+  await expect(page.getByTestId('bench-status')).toHaveAttribute('data-state', 'done', { timeout: 60_000 });
+  await page.getByTestId('bench-run').click();
+  await expect(page.getByTestId('bench-status')).toHaveAttribute('data-state', 'done', { timeout: 60_000 });
+  await expect(page.getByTestId('bench-table').locator('tbody tr')).toHaveCount(7);
+  await expect(page.getByTestId('bench-run')).toBeEnabled();
+});
diff --git a/fixtures/perf-bench/__tests__/format.test.ts b/fixtures/perf-bench/__tests__/format.test.ts
new file mode 100644
index 0000000..7ae683d
--- /dev/null
+++ b/fixtures/perf-bench/__tests__/format.test.ts
@@ -0,0 +1,98 @@
+import { describe, expect, it } from 'vitest';
+import { cellsOf, fmtMs, fmtPair } from '../format';
+import type { BenchRow } from '../scenarios';
+
+// [AI Note]: 표에 쓰는 글을 만드는 순수 함수만 시험한다. 숫자 자체(시간)는 값을 정해 주고 모양만 본다.
+const summary = (p50: number | null, p95: number | null, n = 30) => ({ n, p50, p95, min: p50, max: p95 });
+
+function row(overrides: Partial<BenchRow> = {}): BenchRow {
+  return {
+    id: 'B-05',
+    title: '여러 위치 동시 변경',
+    what: '설명',
+    fixture: { items: 100, nodes: 507, elements: 305, texts: 202, depth: 5 },
+    run: {
+      warmup: 5,
+      runs: 30,
+      samples: [],
+      metrics: { total: summary(1.2346, 2.5), vnode: summary(0.5, 0.75), diff: summary(0.25, 0.5), patch: summary(0.125, 0.25) },
+      counts: { patches: 5 },
+      countsStable: true,
+      errors: 0,
+      errorMessages: [],
+      warmupErrors: 0,
+    },
+    phases: true,
+    dom: { patchLines: 5, byKind: { SET_TEXT: 3, SET_ATTR: 1, INSERT: 1 }, mutationRecords: 5, nodesAdded: 1, nodesRemoved: 0 },
+    preserved: { same: 507, targets: 507 },
+    stateMatches: true,
+    countError: null,
+    ...overrides,
+  };
+}
+
+describe('숫자 글', () => {
+  it('fmtMs: 소수 셋째 자리, null은 "—"', () => {
+    expect(fmtMs(1.23456)).toBe('1.235');
+    expect(fmtMs(0)).toBe('0.000');
+    expect(fmtMs(null)).toBe('—');
+  });
+
+  it('fmtPair: "p50 / p95", 값이 없으면(n = 0) "—"', () => {
+    expect(fmtPair(summary(1.5, 2.25))).toBe('1.500 / 2.250');
+    expect(fmtPair({ n: 0, p50: null, p95: null, min: null, max: null })).toBe('—');
+  });
+});
+
+describe('cellsOf — 한 행의 칸 글 (QA-20이 읽는 data-col)', () => {
+  it('이름 · 항목 수 · 노드 수 · 깊이 · 반복(준비 5 · 측정 30) · 오류 0', () => {
+    const cells = cellsOf(row());
+    expect(cells.name).toBe('B-05 여러 위치 동시 변경');
+    expect(cells.fixture).toBe('항목 100 · 노드 507 · 깊이 5');
+    expect(cells.repeat).toBe('준비 5 · 측정 30');
+    expect(cells.errors).toBe('0');
+  });
+
+  it('시간 칸 = p50 / p95, 단계별 시간이 없는 시나리오(phases false)는 "—"', () => {
+    expect(cellsOf(row()).total).toBe('1.235 / 2.500');
+    expect(cellsOf(row()).vnode).toBe('0.500 / 0.750');
+    const engine = cellsOf(row({ phases: false }));
+    expect([engine.vnode, engine.diff, engine.patch]).toEqual(['—', '—', '—']);
+    expect(engine.total).toBe('1.235 / 2.500');
+  });
+
+  it('DOM 작업 = patch 줄 수와 종류별 개수, MutationObserver 기록 · 추가 · 제거 노드는 따로', () => {
+    const cells = cellsOf(row());
+    expect(cells.dom).toBe('patch 5줄 (SET_TEXT 3 · SET_ATTR 1 · INSERT 1)');
+    expect(cells.mutations).toBe('기록 5 · 추가 노드 1 · 제거 노드 0');
+    expect(cellsOf(row({ dom: { patchLines: 0, byKind: {}, mutationRecords: 0, nodesAdded: 0, nodesRemoved: 0 } })).dom).toBe('patch 0줄');
+  });
+
+  it('노드 참조 유지 · 최종 상태', () => {
+    expect(cellsOf(row()).preserved).toBe('507 / 507');
+    expect(cellsOf(row()).correct).toBe('일치');
+    expect(cellsOf(row({ stateMatches: false })).correct).toBe('불일치');
+  });
+
+  it('오류는 숨기지 않는다: 오류 수 · 메시지, 준비 중 오류, 집계 실행 오류가 칸에 나온다', () => {
+    const base = row();
+    const withErrors = cellsOf(row({ run: { ...base.run, errors: 2, errorMessages: ['boom 1', 'boom 2'], warmupErrors: 1 } }));
+    expect(withErrors.errors).toContain('2건');
+    expect(withErrors.errors).toContain('boom 1');
+    expect(withErrors.errors).toContain('준비 중 1건');
+    const failed = cellsOf(row({ dom: null, preserved: null, stateMatches: null, countError: 'count boom' }));
+    expect(failed.dom).toBe('집계 실패');
+    expect(failed.preserved).toBe('집계 실패');
+    expect(failed.correct).toBe('집계 실패');
+    expect(failed.extra).toContain('count boom');
+  });
+
+  it('비고: 개수(counts)를 시나리오 모양대로 적고, 반복마다 달라지면 알린다', () => {
+    const b06 = cellsOf(row({ id: 'B-06', run: { ...row().run, counts: { setters: 10, renders: 10 } } }));
+    expect(b06.extra).toBe('setter 10번 → 렌더 10번');
+    const b07 = cellsOf(row({ id: 'B-07', run: { ...row().run, counts: { actions: 13, renders: 16 } } }));
+    expect(b07.extra).toBe('동작 13번 → 렌더 16번');
+    expect(cellsOf(row()).extra).toBe('측정 반복마다 patch 5줄');
+    expect(cellsOf(row({ run: { ...row().run, countsStable: false } })).extra).toContain('반복마다 개수가 달라졌습니다');
+  });
+});
diff --git a/fixtures/perf-bench/__tests__/runner.test.ts b/fixtures/perf-bench/__tests__/runner.test.ts
new file mode 100644
index 0000000..f1819f9
--- /dev/null
+++ b/fixtures/perf-bench/__tests__/runner.test.ts
@@ -0,0 +1,182 @@
+import { describe, expect, it, vi } from 'vitest';
+import { runScenario } from '../runner';
+
+// [AI Note]: 시계를 가짜로 꽂아 결정적으로 시험한다. now()를 부를 때마다 준비해 둔 값을 차례로 돌려준다.
+function fakeClock(ticks: number[]): () => number {
+  let i = 0;
+  return () => ticks[Math.min(i++, ticks.length - 1)];
+}
+
+describe('runScenario — 준비 5회 · 측정 30회 (PRD §8.2)', () => {
+  it('기본값은 준비 5회 + 측정 30회, 준비 5회는 결과에서 빠지고 측정 30회만 요약된다', () => {
+    const step = vi.fn();
+    const result = runScenario({ setup: () => undefined, step });
+    expect(step).toHaveBeenCalledTimes(35);
+    expect(result.warmup).toBe(5);
+    expect(result.runs).toBe(30);
+    expect(result.samples).toHaveLength(30);
+    expect(result.metrics.total.n).toBe(30);
+    expect(result.errors).toBe(0);
+  });
+
+  it('매 반복(준비 포함) 전에 setup이 불리고, 그 결과(ctx)가 step · teardown에 그대로 간다', () => {
+    const order: string[] = [];
+    let serial = 0;
+    runScenario({
+      warmup: 2,
+      runs: 3,
+      setup: () => {
+        const id = ++serial;
+        order.push(`setup${id}`);
+        return id;
+      },
+      step: (ctx) => void order.push(`step${ctx}`),
+      teardown: (ctx) => void order.push(`teardown${ctx}`),
+    });
+    expect(serial).toBe(5);
+    expect(order.slice(0, 6)).toEqual(['setup1', 'step1', 'teardown1', 'setup2', 'step2', 'teardown2']);
+  });
+
+  it('step 구간만 잰다: setup · teardown 시간은 total에 들어가지 않는다', () => {
+    // now() 호출은 step 시작 전 · 후 한 쌍뿐이다. 100 → 112 = 12ms
+    const result = runScenario({
+      warmup: 0,
+      runs: 1,
+      now: fakeClock([100, 112]),
+      setup: () => undefined,
+      step: () => undefined,
+    });
+    expect(result.samples).toEqual([12]);
+    expect(result.metrics.total).toMatchObject({ n: 1, p50: 12, p95: 12 });
+  });
+
+  it('step이 돌려준 단계별 시간(timings)도 키마다 요약한다, 개수(counts)는 첫 측정값과 안정 여부를 남긴다', () => {
+    let i = 0;
+    const result = runScenario({
+      warmup: 1,
+      runs: 4,
+      setup: () => undefined,
+      step: () => {
+        i++;
+        return { timings: { diff: i, patch: i * 10 }, counts: { patches: 3 } };
+      },
+    });
+    // 준비 1회(i = 1)는 빠지고 i = 2..5
+    expect(result.metrics.diff).toMatchObject({ n: 4, min: 2, max: 5 });
+    expect(result.metrics.patch).toMatchObject({ n: 4, min: 20, max: 50 });
+    expect(result.counts).toEqual({ patches: 3 });
+    expect(result.countsStable).toBe(true);
+  });
+
+  it('개수가 반복마다 다르면 countsStable = false (조용히 하나만 고르지 않는다)', () => {
+    let i = 0;
+    const result = runScenario({
+      warmup: 0,
+      runs: 3,
+      setup: () => undefined,
+      step: () => ({ counts: { patches: ++i } }),
+    });
+    expect(result.countsStable).toBe(false);
+  });
+});
+
+describe('runScenario — 오류는 숨기지 않는다 (PRD §8.2)', () => {
+  it('step이 던진 반복은 samples에서 빠지되 errors 개수와 메시지로 남는다 (n + errors = runs)', () => {
+    let i = 0;
+    const result = runScenario({
+      warmup: 0,
+      runs: 10,
+      setup: () => undefined,
+      step: () => {
+        i++;
+        if (i % 4 === 0) throw new Error(`boom ${i}`);
+      },
+    });
+    expect(result.errors).toBe(2);
+    expect(result.errorMessages).toEqual(['boom 4', 'boom 8']);
+    expect(result.metrics.total.n).toBe(8);
+    expect(result.metrics.total.n + result.errors).toBe(result.runs);
+  });
+
+  it('setup이 던진 반복도 오류로 센다 (step · teardown은 부르지 않음)', () => {
+    const step = vi.fn();
+    const teardown = vi.fn();
+    const result = runScenario({
+      warmup: 0,
+      runs: 3,
+      setup: () => {
+        throw new Error('setup boom');
+      },
+      step,
+      teardown,
+    });
+    expect(result.errors).toBe(3);
+    expect(step).not.toHaveBeenCalled();
+    expect(teardown).not.toHaveBeenCalled();
+    expect(result.metrics.total).toEqual({ n: 0, p50: null, p95: null, min: null, max: null });
+  });
+
+  it('준비 실행의 오류도 따로 센다 (warmupErrors) — 측정 결과에는 안 들어가지만 설명 없이 사라지지 않는다', () => {
+    let i = 0;
+    const result = runScenario({
+      warmup: 3,
+      runs: 2,
+      setup: () => undefined,
+      step: () => {
+        i++;
+        if (i <= 2) throw new Error('warm boom');
+      },
+    });
+    expect(result.warmupErrors).toBe(2);
+    expect(result.errors).toBe(0);
+    expect(result.samples).toHaveLength(2);
+  });
+
+  it('step이 던져도 teardown은 부른다 (다음 반복이 오염되지 않게)', () => {
+    const teardown = vi.fn();
+    runScenario({
+      warmup: 0,
+      runs: 2,
+      setup: () => 'ctx',
+      step: () => {
+        throw new Error('x');
+      },
+      teardown,
+    });
+    expect(teardown).toHaveBeenCalledTimes(2);
+    expect(teardown).toHaveBeenCalledWith('ctx');
+  });
+
+  it('오류가 아닌 값(문자열)을 던져도 메시지로 남긴다', () => {
+    const result = runScenario({
+      warmup: 0,
+      runs: 1,
+      setup: () => undefined,
+      step: () => {
+        throw 'plain string';
+      },
+    });
+    expect(result.errorMessages).toEqual(['plain string']);
+  });
+
+  it('오류 메시지는 최대 개수까지만 보관하고 errors 숫자는 전부 센다', () => {
+    const result = runScenario({
+      warmup: 0,
+      runs: 30,
+      setup: () => undefined,
+      step: () => {
+        throw new Error('same');
+      },
+    });
+    expect(result.errors).toBe(30);
+    expect(result.errorMessages.length).toBeLessThanOrEqual(10);
+  });
+});
+
+describe('runScenario — 인자 검사', () => {
+  it('runs가 1보다 작거나 정수가 아니면 오류, warmup이 음수여도 오류', () => {
+    expect(() => runScenario({ runs: 0, setup: () => undefined, step: () => undefined })).toThrow('runs');
+    expect(() => runScenario({ runs: 2.5, setup: () => undefined, step: () => undefined })).toThrow('runs');
+    expect(() => runScenario({ warmup: -1, setup: () => undefined, step: () => undefined })).toThrow('warmup');
+  });
+});

+++ b/fixtures/mini-figma/previewNav.ts
@@ -0,0 +1,31 @@
+import { HISTORY_LIMIT } from '@mini-react/shared';
+
+// [AI Note]: 실제 영역의 「뒤로 · 앞으로 갈 수 있나」를 세는 순수 모델 (PP-06). 엔진 VDomRoot에는 가능 여부를 묻는 메서드가 없고
+// 엔진은 고치지 않으므로, 앱이 엔진 History와 같은 규칙으로 따로 센다: 처음 모습 = 0번 · 뒤로 간 뒤 새 Patch면 앞쪽을 버림 · 경계 이동 무시 · 한도 HISTORY_LIMIT(50)이 넘으면 맨 앞을 뺌.
+// index = 지금 기록이 맨 앞에서 몇 칸째(0부터), size = 들고 있는 기록 수.
+export interface PreviewNav {
+  readonly index: number;
+  readonly size: number;
+}
+
+export const INITIAL_NAV: PreviewNav = { index: 0, size: 1 };
+
+/** Patch로 새 기록이 하나 쌓임: 앞쪽(index 뒤)을 버리고 하나 붙이고, 한도를 넘으면 맨 앞을 뺀다 */
+export function navPush(nav: PreviewNav): PreviewNav {
+  const size = nav.index + 2;
+  if (size > HISTORY_LIMIT) return { index: HISTORY_LIMIT - 1, size: HISTORY_LIMIT };
+  return { index: nav.index + 1, size };
+}
+
+/** 경계(처음)에서는 같은 객체를 돌려줘 setter가 렌더를 안 일으키게 한다 */
+export function navBack(nav: PreviewNav): PreviewNav {
+  return nav.index === 0 ? nav : { index: nav.index - 1, size: nav.size };
+}
+
+/** 경계(끝)에서는 같은 객체 */
+export function navForward(nav: PreviewNav): PreviewNav {
+  return nav.index === nav.size - 1 ? nav : { index: nav.index + 1, size: nav.size };
+}
+
+export const canBack = (nav: PreviewNav): boolean => nav.index > 0;
+export const canForward = (nav: PreviewNav): boolean => nav.index < nav.size - 1;
diff --git a/fixtures/mini-figma/previewVNode.ts b/fixtures/mini-figma/previewVNode.ts
new file mode 100644
index 0000000..2f4ac85
--- /dev/null
+++ b/fixtures/mini-figma/previewVNode.ts
@@ -0,0 +1,36 @@
+import { COMMENT_NODE, TEXT_NODE } from '@mini-react/shared';
+import type { AreaChildren, Props, VNode } from '@mini-react/shared';
+
+// [AI Note]: 실제 영역에 넣기 전에 테스트 영역에서 읽은 VNode를 정리하는 순수 함수 (PP-05). DOM · Hook · 엔진을 모른다.
+// 정리 세 가지: ① 테스트 영역 제목(test-area-title)을 최상위에서 뺀다 ② 고르기 표시(`selected` 클래스 토큰)를 뺀다 — 고르기는 실제 영역과 상관없다
+// ③ data-testid 앞에 `real-`을 붙인다 — 테스트 영역 testid(figma-button 등)가 실제 영역에 남으면 두 영역이 같은 이름을 가져 구분이 안 된다.
+// 입력은 고치지 않고 새 객체를 돌려준다. 글자 · 주석 노드와 그 밖의 속성(style · data-id · type)은 그대로 둔다.
+
+const TITLE_TESTID = 'test-area-title';
+const REAL_PREFIX = 'real-';
+
+function cleanProps(props: Props): Props {
+  const next: { [name: string]: unknown } = { ...props };
+  const cls = next.class;
+  if (typeof cls === 'string') {
+    // 토큰 단위로만 지운다: `unselected` · `not-selected` 같은 비슷한 이름은 그대로
+    const tokens = cls.split(/\s+/).filter((token) => token !== '' && token !== 'selected');
+    if (tokens.length === 0) delete next.class;
+    else next.class = tokens.join(' ');
+  }
+  const testid = next['data-testid'];
+  if (typeof testid === 'string') next['data-testid'] = `${REAL_PREFIX}${testid}`;
+  return next;
+}
+
+function cleanNode(node: VNode): VNode {
+  // DOM에서 읽은 VNode만 들어오므로 요소는 type이 태그 이름(문자열)이다. 글자 · 주석은 그대로
+  if (node.type === TEXT_NODE || node.type === COMMENT_NODE) return node;
+  return { ...node, props: cleanProps(node.props), children: node.children.map(cleanNode) } as VNode;
+}
+
+export function toRealVNodes(children: AreaChildren): AreaChildren {
+  return children
+    .filter((node) => (node.props as Props)['data-testid'] !== TITLE_TESTID)
+    .map(cleanNode);
+}

+
+  it('testid가 없는 요소 · 속성은 그대로 (키가 생기지 않는다)', () => {
+    const [out] = toRealVNodes([el('i', { 'data-id': 'b1' })]);
+    expect(out.props).toEqual({ 'data-id': 'b1' });

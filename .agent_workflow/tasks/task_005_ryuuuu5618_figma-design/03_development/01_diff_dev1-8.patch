+  // ③ b1을 고르고 ↻: 「메인 따름」, b1이 메인 색(빨강)을 따라감, 'undefined' 글자가 화면에 없음
+  await selectOnCanvas(page, 'b1');
+  await page.locator(inRow('color', 'prop-reset')).click();

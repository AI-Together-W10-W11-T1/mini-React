+import type { FunctionComponent } from '@mini-react/react-reconciler';
+import type { Patch, Path, StateHook, VNode } from '@mini-react/shared';
+import { App } from '../App';
+import { INITIAL_DOC } from '../model';
+import { EMPTY_UNDO } from '../undo';

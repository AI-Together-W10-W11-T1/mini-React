+  it('Undo 때문에 묶음이 끝난다: Undo 뒤 같은 칸 수정은 새 단계', () => {
+    const [d0, d1, d2] = [docOf(0), docOf(1), docOf(2)];
+    const state = recordEdit(EMPTY_UNDO, d0, d1, mainLabel); // past [d0]
+    const back = undo(state, d1); // → d0, past [], group null

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "vitest/globals"
    ],
    "skipLibCheck": true,
    "paths": {
      "@mini-react/*": [
        "./packages/*/src"
      ]
    }
  },
  "include": [
    "packages",
    "fixtures",
    "e2e"
  ]
}